<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for every network call the app makes (Supabase, Google
         Maps tiles, ...). The debug/profile manifests get this for free
         from Flutter's own debug.xml, but a release build only merges
         this main manifest - without it, release builds silently freeze
         on the native splash screen forever since the unhandled network
         failure during main() happens before runApp() ever draws a frame. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Captain incoming-ride-request alerts: local notification (Android
         13+ requires runtime POST_NOTIFICATIONS, requested by
         RideNotificationService.initialize()) and vibration pattern
         (RideAlertService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice search on the district/place map picker (speech_to_text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- TripForegroundService: keeps the process alive (with a persistent
         notification, Android's own requirement for this) while a trip is
         active, so the OS can't kill the app in the background and
         silently break trip tracking/realtime updates. FOREGROUND_SERVICE
         is required on Android 9+ for any foreground service at all;
         FOREGROUND_SERVICE_DATA_SYNC specifically on Android 14+, matching
         the service's declared foregroundServiceType below (this keeps a
         realtime/network connection alive, not GPS - the customer's own
         location is never tracked during a trip, only the captain's). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Captain side (unified app): the open-ride live-tracking screen runs
         as a location foreground service so Android doesn't kill the app
         (losing the fare meter) mid-trip. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Captain side: in-app camera for document/photo capture during
         registration (image_picker). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Captain side: lets the new-trip-request alert pop the app to the
         foreground over the lock screen (like an incoming call) instead of
         waiting for the notification shade. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="الهدهد"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Google Maps SDK API key for the destination map picker (Phase 2).
             Sourced from android/local.properties (MAPS_API_KEY, gitignored) -
             see android/app/build.gradle.kts. Empty by default. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <!-- Captain side (unified app): google_maps_flutter's native map is
             a PlatformView, which Flutter's Impeller renderer has known
             blank-map compositing bugs with on some Android GPUs even when
             the key/billing are fine. Falling back to Skia is the standard
             fix and is safe for the customer map screens too. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name=".TripForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ (API 30+) package-visibility: without this,
             url_launcher's canLaunchUrl(Uri(scheme: 'tel', ...)) - which
             resolves via ACTION_VIEW - can never see any dialer app and
             always returns false, so TripTrackingScreen._callCaptain
             silently does nothing when tapped: no error, no dialer, no
             feedback. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Captain side (unified app): so url_launcher can open the
             WhatsApp support link (https) and the phone dialer (tel/DIAL). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>
</manifest>

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. When unset, every map falls back to free OpenStreetMap tiles
# (see lib/core/services/map_tile_provider.dart) - no build breaks without
# it. Get a key at https://cloud.maptiler.com (free tier available).
MAPTILER_API_KEY=your-maptiler-api-key

# Optional. Same Android-restricted Maps SDK key used for
# android/local.properties's MAPS_API_KEY (see android/app/build.gradle.kts) -
# also enables real road-based routing (distance/duration/polyline) via the
# Google Directions API instead of a straight-line estimate; see
# lib/core/services/google_directions_route_estimator.dart. Needs "Directions
# API" added to that key's API restrictions in Google Cloud Console. When
# unset or the request fails, ride screens fall back to the straight-line
# estimate - no build breaks without it.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

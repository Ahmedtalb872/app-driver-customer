SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. When unset, every map falls back to free OpenStreetMap tiles
# (see lib/core/services/map_tile_provider.dart) - no build breaks without
# it. Get a key at https://cloud.maptiler.com (free tier available).
MAPTILER_API_KEY=your-maptiler-api-key

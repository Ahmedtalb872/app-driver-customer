SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. When unset, every map falls back to free OpenStreetMap tiles
# (see lib/core/services/map_tile_provider.dart) - no build breaks without
# it. Get a key at https://cloud.maptiler.com (free tier available).
MAPTILER_API_KEY=your-maptiler-api-key

# Optional. Same Android-restricted Maps SDK key used for
# android/local.properties's MAPS_API_KEY (see android/app/build.gradle.kts).
# Also enables, each independently and each falling back cleanly to a
# lesser experience if unset/failing rather than breaking the build:
#   - real road-based routing (distance/duration/polyline) via the Google
#     Directions API instead of a straight-line estimate - needs "Directions
#     API" added to this key's API restrictions; see
#     lib/core/services/google_directions_route_estimator.dart.
#   - destination search (typed and voice) also finding real Google Maps
#     places, not just this app's own places/districts/neighborhoods
#     registry - needs "Places API" added to this key's API restrictions;
#     see lib/core/services/google_places_search_service.dart.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
